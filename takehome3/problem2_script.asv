clear; clc; close all;

set_param('problem2/Manual Switch', 'sw', '0');
out = sim('problem2.slx');

% plot error
figure;
plot(out.logsout.get('err').Values);
title('Error Signal');
xlabel('Time (s)');
ylabel('Error');
grid on;

