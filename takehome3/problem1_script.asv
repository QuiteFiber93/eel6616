clear; clc; close all;

% Run problem1.slx
simOut = sim('problem1');

y_m = simOut.logsout.get('y_m').Values;
y_p = simOut.logsout.get('y_p').Values;
u = simOut.logsout.get('u').Values;
b_hat = simOut.logsout.get('b_hat').Values;
a_hat = simOut.logsout.get('a_hat').Values;

% Plot y_m and y_p vs t
figure;
hold on
stairs(y_m.Time, y_m.Data, 'b');
stairs(y_p.Time, y_p.Data, 'r');
hold off
xlabel('Time steps');
ylabel('Output');
legend('y_m (Model)', 'y_p (Plant)');
title('Model vs Plant Output');
grid on;

% Plot u vs t
figure;
stairs(u.Time, u.Data, 'k');
xlabel('Time steps');
ylabel('u');
title('Control Input');
grid on;

% Plot b and a estimates
figure;
subplot(2,1,1);
stairs(b_hat.Time, b_hat.Data, 'b');
xlabel('Time steps');
ylabel('b_{hat}');
title('b_{hat} Estimate');
grid on;

subplot(2,1,2);
stairs(a_hat.Time, a_hat.Data, 'r');
yline(0.)
xlabel('Time steps');
ylabel('a_{hat}');
title('a_{hat} Estimate');
grid on;
