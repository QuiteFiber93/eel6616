clear; clc; 

gradientEstimator = "gradient_estimator";
load_system(gradientEstimator)

gains = [0.1, 0.5, 1, 5];

figure
hold on
for n = 1:length(gains)
    mdlWks = get_param(gradientEstimator, 'ModelWorkSpace');
    assignin(mdlWks, 'g', -gains(n));

    simOut = sim(gradientEstimator);

    theta = simOut.theta;
    plot(theta.Time)
end

hold off